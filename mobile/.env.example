# Backend API base URL the app talks to.
# When testing on a physical phone with Expo Go, "localhost" means the PHONE,
# not your computer - use your computer's LAN IP instead, e.g. http://192.168.1.20:4000/api
EXPO_PUBLIC_API_URL=http://localhost:4000/api

# Google ile giriş (opsiyonel): native @react-native-google-signin/google-signin
# kullanır (expo-auth-session'ın tarayıcı tabanlı Google sağlayıcısı Expo
# tarafından deprecated ilan edildi ve Google artık bu akışı "yüklenmiş
# uygulama" istemcileri için reddediyor -- "Error 400: invalid_request").
#
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID: ZORUNLU (Google Cloud Console > APIs &
# Services > Credentials > "Web application" tipinde bir istemci oluşturun).
# Her iki platformda da bu kullanılır -- ID token'ın "aud" alanı buna göre
# doğrulanır. Aynı ID'yi server/.env (ya da Render) içindeki GOOGLE_CLIENT_IDS
# listesine de eklemeniz gerekir, çünkü jetonu doğrulayan asıl kontrol
# backend'de yapılır.
#
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID: sadece iOS'ta ek olarak kullanılır
# (opsiyonel, "iOS" tipinde bir istemciden).
#
# Ayrıca (JS koduna hiç girmese de) bir "Android" tipinde istemci de
# oluşturup uygulamanın paket adını (app.uspulse.mobile) ve imzalayan
# keystore'un SHA-1 parmak izini eklemeniz gerekir -- native SDK, Android'de
# doğrulamayı JS'e hiç bir client ID vermeden, cihaz üzerinde bu kayıtla
# yapıyor. Debug ve release build'leri farklı keystore'la imzalıyorsanız her
# ikisinin SHA-1'ini de aynı Android istemciye ekleyin.
#
# Boş bırakılan EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID, "Google ile giriş yap"
# butonunun ayarlanmadığını açıklayan bir uyarı göstermesine yol açar.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
