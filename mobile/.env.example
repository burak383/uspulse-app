# Backend API base URL the app talks to.
# When testing on a physical phone with Expo Go, "localhost" means the PHONE,
# not your computer - use your computer's LAN IP instead, e.g. http://192.168.1.20:4000/api
EXPO_PUBLIC_API_URL=http://localhost:4000/api

# Google ile giriş (opsiyonel): Google Cloud Console > APIs & Services >
# Credentials üzerinden oluşturduğunuz OAuth 2.0 istemci kimliklerini buraya
# girin. Sadece kullandığınız platformlar için client ID girmeniz yeterli;
# boş bırakılan alanlar o platformda "Google ile giriş yap" butonunun
# ayarlanmadığını açıklayan bir uyarı göstermesine yol açar. Aynı client
# ID'lerini server/.env içindeki GOOGLE_CLIENT_IDS listesine de eklemeniz
# gerekir, çünkü jetonu doğrulayan asıl kontrol backend'de yapılır.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Facebook ile giriş (opsiyonel): Meta for Developers'da oluşturduğunuz
# uygulamanın Uygulama Kimliği'ni (App ID) buraya girin. Google'dan farklı
# olarak Facebook'ta platform başına ayrı bir kimlik yok -- tek App ID hem
# iOS hem Android hem web için kullanılıyor. Aynı değeri server/.env
# içindeki FACEBOOK_APP_ID'ye de eklemeniz gerekir (App Secret'i SADECE
# server/.env'e girin, buraya asla değil).
EXPO_PUBLIC_FACEBOOK_APP_ID=
