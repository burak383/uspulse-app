PORT=4000
JWT_SECRET=change-this-to-a-long-random-string
DB_PATH=./data/uspulse.db

# Google ile giriş (opsiyonel): Google Cloud Console'da OAuth istemci kimlikleri
# oluşturup (iOS + Android + Web tipleri) buraya virgülle ayırarak ekleyin.
# Boş bırakılırsa POST /api/auth/google 501 döner ve mobil uygulamadaki
# "Google ile giriş yap" butonu bunu açıklayan bir uyarı gösterir.
GOOGLE_CLIENT_IDS=

# Facebook ile giriş (opsiyonel): Meta for Developers'da bir uygulama oluşturup
# Settings > Basic'ten Uygulama Kimliği (App ID) ve Uygulama Gizli Anahtarı'nı
# (App Secret) buraya girin. İkisi de boşsa POST /api/auth/facebook 501 döner
# ve mobil uygulamadaki "Facebook ile giriş yap" butonu bunu açıklayan bir
# uyarı gösterir. App Secret'i asla mobile/.env'e veya istemci koduna kopyalamayın.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# development dışındaki bir değer (örn. production), şifre sıfırlama kodunun
# API yanıtında (devCode) geri gönderilmesini kapatır - bkz. README.
NODE_ENV=development
