PORT=4000
JWT_SECRET=change-this-to-a-long-random-string
DB_PATH=./data/uspulse.db

# Google ile giriş (opsiyonel): Google Cloud Console'da OAuth istemci kimlikleri
# oluşturup (iOS + Android + Web tipleri) buraya virgülle ayırarak ekleyin.
# Boş bırakılırsa POST /api/auth/google 501 döner ve mobil uygulamadaki
# "Google ile giriş yap" butonu bunu açıklayan bir uyarı gösterir.
GOOGLE_CLIENT_IDS=

# development dışındaki bir değer (örn. production), şifre sıfırlama kodunun
# API yanıtında (devCode) geri gönderilmesini kapatır - bkz. README.
# NOT: Render bu değişkeni otomatik AYARLAMAZ, Dashboard > Environment'tan elle
# eklenmesi gerekir. Render, kendi RENDER değişkenini her zaman otomatik koyar
# ve kod bunu da (NODE_ENV'e ek olarak) "gerçekten canlı mı" sinyali olarak
# kullanır - bkz. routes/auth.ts, index.ts.
NODE_ENV=development

# RevenueCat > Project Settings > Webhooks'ta tanımladığın Authorization
# header değeri (Bearer <bu-değer>). RevenueCat, abonelik olaylarını
# (satın alma/yenileme/iptal/süre dolması) bu paylaşılan sırla imzalanmış bir
# istekle POST /api/webhooks/revenuecat'e gönderir - bkz. routes/webhooks.ts.
# Boş bırakılırsa abonelik durumu asla güncellenmez.
REVENUECAT_WEBHOOK_SECRET=

# Şifre sıfırlama kodunun gerçekten e-postayla gönderilebilmesi için Resend
# (https://resend.com) API anahtarı - bkz. email.ts. Boş bırakılırsa hiçbir
# e-posta gönderilmez; kod sadece sunucu loguna yazılır ve (production
# dışında) API yanıtında devCode olarak döner, böylece sıfırlama akışı yine
# de uçtan uca test edilebilir. Resend Dashboard > API Keys'ten alınır.
RESEND_API_KEY=

# İsteğe bağlı: gönderen adresi. Resend'de kendi alan adınızı doğrulamadan
# (Domains sekmesi) sadece "onboarding@resend.dev" ile gönderim yapabilirsiniz;
# boş bırakılırsa zaten bu adres varsayılan olarak kullanılır. Kendi alan
# adınızı doğruladıktan sonra örn. "UsPulse <no-reply@uspulse.app>" yapın.
RESEND_FROM_EMAIL=

# Gizlilik politikası, kullanım koşulları ve veri silme sayfalarında
# (routes/legal.ts) "bize ulaşın" bağlantısı olarak gösterilen e-posta adresi.
# Boş bırakılırsa kod içindeki varsayılan (seolen8@gmail.com) kullanılır.
LEGAL_CONTACT_EMAIL=

# Yüklenen anı medyalarının (fotoğraf/video/ses) diskte saklandığı klasör -
# bkz. uploads.ts. Boş bırakılırsa ./data/uploads kullanılır. Render'ın
# ücretsiz planında bu klasör kalıcı değildir (her yeniden başlayışta silinir);
# kalıcı diske geçtiğinde bu değişkeni o diskin bağlandığı yola ayarla.
UPLOADS_DIR=./data/uploads
